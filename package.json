{
  "name": "polymind",
  "version": "0.1.0",
  "private": true,
  "description": "One adaptive AI endpoint powered by every model you own.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @polymind/gateway dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:coverage": "vitest run --coverage",
    "ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "doctor": "pnpm --filter @polymind/cli polymind doctor",
    "audit:deps": "pnpm audit --audit-level moderate"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.0.14",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.14"
  }
}
